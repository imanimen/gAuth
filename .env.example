# --- database ---
dsn=root:''@tcp(127.0.0.1:3306)/go-auth?charset=utf8mb4&parseTime=True&loc=Local
dbName=gAuth

# --- api ---
apiVersion=v1
PORT=8080
# JWT signing secret (legacy alias: jWT)
SECRET=change-me
# Access token lifetime, e.g. 10m, 1h (default 10m)
TOKEN_TTL=10m
# Expose the Swagger UI at /swagger/*
ENABLE_SWAGGER=true

# --- external services ---
NOTIFY_API_URL=
CDN_URL=
FILE_SERVICE_URL=

# --- google oauth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/oauth/callback
# Optional overrides; defaults point at the real Google endpoints
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
